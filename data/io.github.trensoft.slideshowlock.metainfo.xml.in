<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.trensoft.slideshowlock</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later AND CC-BY-SA-4.0</project_license>
  <name>Slideshow Lock</name>
  <summary>Idle slideshow screensaver that locks on input</summary>
  <developer id="io.github.trensoft">
    <name translate="no">TrenSoft</name>
  </developer>
  <description>
    <p>Slideshow Lock starts a fullscreen picture slideshow on every screen when the session has been idle for a set time.</p>
    <p>The first key press, click or mouse movement ends the slideshow. If the slideshow has been showing for at least the grace period, the session is locked as well.</p>
    <p>The pictures come from a folder you choose. A settings window sets the folder, the idle time, the grace period, how long each picture shows, the order and the scaling.</p>
  </description>
  <launchable type="desktop-id">io.github.trensoft.slideshowlock.desktop</launchable>
  <url type="homepage">https://github.com/trensoft/slideshow-lock</url>
  <url type="bugtracker">https://github.com/trensoft/slideshow-lock/issues</url>
  <categories>
    <category>Settings</category>
  </categories>
  <provides>
    <binary>slideshow-lock</binary>
    <binary>slideshowlock</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.9" date="2026-10-09">
      <description translate="no">
        <p>An About window in the settings window, with a link to support the project. The exit status 1 is listed in the manual page.</p>
      </description>
    </release>
    <release version="1.0.8" date="2026-10-09">
      <description translate="no">
        <p>Manual pages for both commands. A slideshow window whose size never settles no longer makes the same picture over and over.</p>
      </description>
    </release>
    <release version="1.0.7" date="2026-10-09">
      <description translate="no">
        <p>The first picture of the slideshow now gets the slow Ken Burns move by the same rule as the later pictures.</p>
      </description>
    </release>
    <release version="1.0.6" date="2026-10-09"/>
    <release version="1.0.5" date="2026-10-08"/>
    <release version="1.0.4" date="2026-10-08"/>
    <release version="1.0.3" date="2026-10-08"/>
    <release version="1.0.2" date="2026-10-07"/>
    <release version="1.0.1" date="2026-10-07"/>
    <release version="1.0.0" date="2026-10-06"/>
  </releases>
</component>

[Desktop Entry]
Type=Application
Name=Slideshow Lock
Comment=Set up the idle slideshow and the session lock
Exec=slideshow-lock settings
TryExec=slideshow-lock
Icon=io.github.sakkmesterke.SlideshowLock
Terminal=false
StartupNotify=true
StartupWMClass=io.github.sakkmesterke.SlideshowLock.Preferences
Categories=GNOME;GTK;Settings;DesktopSettings;
Keywords=screensaver;slideshow;pictures;idle;lock;

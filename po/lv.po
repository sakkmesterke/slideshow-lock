#: slideshow_lock/__init__.py
#: data/io.github.sakkmesterke.SlideshowLock.desktop.in
#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "Nejauši"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "Pēc faila nosaukuma"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "Aizpildīt ekrānu (apgriež attēlu)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "Pielāgot (rāda visu attēlu)"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "Slideshow Lock iestatījumi"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "Pārlūkot…"

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "Attēli"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "Attēlu mape"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "Attēlu secība"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "Mērogošana"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "Ritināt augstus attēlus"

#: slideshow_lock/preferences.py
msgid ""
"Portrait pictures on a landscape screen move slowly from top to bottom (only "
"with Fill). Off by default: it uses more battery."
msgstr ""
"Portreta orientācijas attēli ainavas orientācijas ekrānā lēni pārvietojas no "
"augšas uz leju (tikai ar opciju “Aizpildīt”). Pēc noklusējuma izslēgts: tas "
"patērē vairāk akumulatora enerģijas."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "Sākt slaidrādi"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "Dīkstāves laiks"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "Cik ilgi bez ievades, pirms sākas slaidrāde."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "sekundes"

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "Ilgumi"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "Rādīt katru attēlu"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "Bloķēšanas atlikšanas laiks"

#: slideshow_lock/preferences.py
msgid ""
"Input sooner than this after the slideshow starts does not lock the session "
"(strictly sooner; 0 means every input locks)."
msgstr ""
"Ievade, kas notiek agrāk nekā šajā laikā pēc slaidrādes sākuma, nebloķē "
"sesiju (stingri agrāk; 0 nozīmē, ka katra ievade bloķē)."

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "Priekšskatījums"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 s"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 min"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 h"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 h"

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "Izvēlieties attēlu mapi"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "Izvēlēties"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "Atcelt"

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "Priekšskatījumu neizdevās sākt, skatiet žurnālu."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "Nav monitora, kurā rādīt priekšskatījumu."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr ""
"Priekšskatījums darbojas: nospiediet jebkuru taustiņu vai pakustiniet peli, "
"lai to beigtu."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "Mainīt slaidrādes iestatījumus."

#: slideshow_lock/preferences.py slideshow_lock/preview_app.py
#: slideshow_lock/service.py
msgid "log every step"
msgstr "reģistrēt katru soli"

#: slideshow_lock/preferences.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr ""
"Iestatījumu shēma nav instalēta. Sakompilējiet to un norādiet GSettings uz "
"to:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "Saglabāts."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "visgarākais"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d min"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d h"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "Lietots: %s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "Lietots: %s (mape vēl nepastāv, nekas netiks rādīts)"

#: slideshow_lock/preferences_model.py
msgid ""
"Not a step of the slider: it shows the nearest one. The saved value stays "
"until you move the slider."
msgstr ""
"Tas nav slīdņa solis: tiek rādīts tuvākais. Saglabātā vērtība paliek, līdz "
"pārvietosiet slīdni."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "Ievadiet veselu sekunžu skaitu."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "Vērtībai jābūt starp %(low)d un %(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "Ievadiet veselu skaitli slīdņa pozīcijai."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "Šīs pozīcijas slīdnī nav."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "Šī izvēle nav pieejama."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "Tam jābūt ieslēgtam vai izslēgtam."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "Ievadiet mapes ceļu."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "Ceļā ir rakstzīme, kas nav atļauta."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "Ievadiet absolūtu ceļu (tas sākas ar / vai ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "Šis ceļš ir fails, nevis mape."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "Vērtība netika pieņemta, vecā tiek saglabāta."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "Vērtību neizdevās saglabāt."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "Mape netika pieņemta, vecā tiek saglabāta."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "Mapi neizdevās saglabāt."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "Nav attēlu, ko rādīt"

#: slideshow_lock/preview_app.py
msgid ""
"Show the slideshow preview. Any input ends it. It never locks the session."
msgstr ""
"Rādīt slaidrādes priekšskatījumu. Jebkura ievade to beidz. Tas nekad nebloķē "
"sesiju."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "attēlu mape (tikai šai palaišanai)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "sekundes uz attēlu (tikai šai palaišanai)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "attēlu secība"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "pielāgot vai aizpildīt monitoru"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "lēni ritināt portreta orientācijas attēlus (aizpildīšanas režīms)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "Intervālam jābūt starp %d un %d sekundēm."

#: slideshow_lock/preview_app.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr ""
"Iestatījumu shēma nav instalēta. Sakompilējiet to un norādiet GSettings uz "
"to:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "Slideshow Lock priekšskatījums"

#: slideshow_lock/service.py
msgid ""
"Start the slideshow when the session is idle, lock it on the first input "
"after the grace period, and lock before the machine suspends."
msgstr ""
"Sākt slaidrādi, kad sesija ir dīkstāvē, bloķēt sesiju pirmajā ievadē pēc "
"atlikšanas laika un bloķēt pirms datora iemiegšanas."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "dīkstāves sekundes pirms slaidrādes"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "nebloķēt ievadei šajā sekunžu skaitā"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "Dīkstāves noildzei jābūt starp 1 un 86400 sekundēm."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "Atlikšanas laikam jābūt starp 0 un 86400 sekundēm."

#: slideshow_lock/service.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr ""
"Iestatījumu shēma nav instalēta. Sakompilējiet to un norādiet GSettings uz "
"to:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.sakkmesterke.SlideshowLock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "Iestatīt slaidrādi dīkstāvē un sesijas bloķēšanu"

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr "Ekrānsaudzētājs ar slaidrādi dīkstāvē, kas bloķē pēc ievades"

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid ""
"Slideshow Lock starts a fullscreen picture slideshow on every screen when "
"the session has been idle for a set time."
msgstr ""
"Slideshow Lock sāk pilnekrāna attēlu slaidrādi katrā ekrānā, kad sesija ir "
"bijusi dīkstāvē noteiktu laiku."

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid ""
"The first key press, click or mouse movement ends the slideshow. If the "
"slideshow has been showing for at least the grace period, the session is "
"locked as well."
msgstr ""
"Pirmais taustiņa nospiediens, klikšķis vai peles kustība beidz slaidrādi. Ja "
"slaidrāde ir rādīta vismaz atlikšanas laiku, sesija tiek arī bloķēta."

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid ""
"The pictures come from a folder you choose. A settings window sets the "
"folder, the idle time, the grace period, how long each picture shows, the "
"order and the scaling."
msgstr ""
"Attēli nāk no jūsu izvēlētas mapes. Iestatījumu logs nosaka mapi, dīkstāves "
"laiku, atlikšanas laiku, cik ilgi tiek rādīts katrs attēls, secību un "
"mērogošanu."

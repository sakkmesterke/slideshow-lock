#: slideshow_lock/__init__.py
#: data/io.github.trensoft.slideshowlock.desktop.in
#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/control.py
msgid "Start the slideshow service and open the settings window."
msgstr "Pokrenite uslugu prezentacije slika i otvorite prozor postavki."

#: slideshow_lock/control.py
msgid "at login: start the service, open the window only the first time"
msgstr "pri prijavi: pokrenuti uslugu, otvoriti prozor samo prvi put"

#: slideshow_lock/control.py slideshow_lock/preferences.py
#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "log every step"
msgstr "zapisuj svaki korak"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "Nasumično"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "Po nazivu datoteke"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "Ispuni zaslon (slika se obrezuje)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "Prilagodi (prikazuje se cijela slika)"

#: slideshow_lock/preferences.py
msgid "None (change at once)"
msgstr "Nema (trenutna promjena)"

#: slideshow_lock/preferences.py
msgid "Cross-fade"
msgstr "Križno stapanje"

#: slideshow_lock/preferences.py
msgid "Fade through black"
msgstr "Stapanje kroz crno"

#: slideshow_lock/preferences.py
msgid "Slide in"
msgstr "Uklizavanje"

#: slideshow_lock/preferences.py
msgid "Push"
msgstr "Guranje"

#: slideshow_lock/preferences.py
msgid "Ken Burns"
msgstr "Ken Burns"

#: slideshow_lock/preferences.py
msgid "Zoom"
msgstr "Zumiranje"

#: slideshow_lock/preferences.py
msgid "Wipe"
msgstr "Brisanje"

#: slideshow_lock/preferences.py
msgid "Circle reveal"
msgstr "Kružno otkrivanje"

#: slideshow_lock/preferences.py
msgid "Blur"
msgstr "Zamućenje"

#: slideshow_lock/preferences.py
msgid "Rotate"
msgstr "Rotacija"

#: slideshow_lock/preferences.py
msgid "Random mix"
msgstr "Nasumična mješavina"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "Postavke aplikacije Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "Mapa sa slikama"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "Pregledaj…"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "Redoslijed slika"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "Skaliranje"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "Pomicanje visokih slika"

#: slideshow_lock/preferences.py
msgid ""
"Portrait pictures on a landscape screen move slowly from top to bottom (only "
"with Fill). Off by default: it uses more battery."
msgstr ""
"Slike u portretnom usmjerenju na zaslonu u pejzažnom usmjerenju polako se "
"pomiču odozgo prema dolje (samo uz „Ispuni”). Prema zadanim postavkama "
"isključeno: troši više baterije."

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "Slike"

#: slideshow_lock/preferences.py
msgid "Between pictures"
msgstr "Između slika"

#: slideshow_lock/preferences.py
msgid ""
"How a picture changes into the next. \"Random mix\" picks one of eight at "
"each change (not Blur and Ken Burns). Without desktop animations the "
"pictures change at once."
msgstr ""
"Kako se jedna slika mijenja u sljedeću. „Nasumična mješavina“ bira jedan od "
"osam pri svakoj promjeni (ne Zamućenje i Ken Burns). Bez animacija radne "
"površine slike se mijenjaju odmah."

#: slideshow_lock/preferences.py
msgid "Transition length"
msgstr "Trajanje prijelaza"

#: slideshow_lock/preferences.py
msgid ""
"How long one change takes, the same for every transition. It is never longer "
"than half of the time a picture is shown."
msgstr ""
"Koliko traje jedna promjena, jednako za svaki prijelaz. Nikad nije dulje od "
"polovice vremena prikazivanja slike."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "sekundi"

#: slideshow_lock/preferences.py
msgid "Transitions"
msgstr "Prijelazi"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "Vrijeme neaktivnosti"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "Koliko dugo bez unosa prije nego što prezentacija slika počne."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "Pokretanje prezentacije slika"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "Trajanje prikaza svake slike"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "Odgoda zaključavanja"

#: slideshow_lock/preferences.py
msgid ""
"Input sooner than this after the slideshow starts does not lock the session "
"(strictly sooner; 0 means every input locks)."
msgstr ""
"Unos ranije od ovog vremena nakon početka prezentacije slika ne zaključava "
"sesiju (strogo ranije; 0 znači da svaki unos zaključava)."

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "Vremenski parametri"

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "Pretpregled"

#: slideshow_lock/preferences.py
msgid "Donate"
msgstr "Doniraj"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 s"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 min"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 h"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 h"

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "Odaberite mapu sa slikama"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "Odaberi"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "Otkaži"

#: slideshow_lock/preferences.py
msgid "The donation page could not be opened, see the log."
msgstr "Stranicu za donacije nije bilo moguće otvoriti, pogledajte zapisnik."

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "Pretpregled nije bilo moguće pokrenuti, pogledajte zapisnik."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "Nema monitora na kojem bi se prikazao pretpregled."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr ""
"Pretpregled je pokrenut: pritisnite bilo koju tipku ili pomaknite miš da ga "
"završite."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "Promjena postavki prezentacije slika."

#: slideshow_lock/preferences.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr ""
"Shema postavki nije instalirana. Kompajlirajte je i usmjerite GSettings na "
"nju:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "Spremljeno."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "najdulje"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d min"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d h"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "U upotrebi: %s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "U upotrebi: %s (mapa još ne postoji, ništa neće biti prikazano)"

#: slideshow_lock/preferences_model.py
msgid ""
"Not a step of the slider: it shows the nearest one. The saved value stays "
"until you move the slider."
msgstr ""
"Nije korak klizača: prikazuje se najbliži. Spremljena vrijednost ostaje dok "
"ne pomaknete klizač."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "Unesite cijeli broj sekundi."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "Vrijednost mora biti između %(low)d i %(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "Unesite cijeli broj za položaj klizača."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "Ovaj položaj nije na klizaču."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "Ovaj izbor nije dostupan."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "Mora biti uključeno ili isključeno."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "Unesite putanju mape."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "Putanja sadrži znak koji nije dopušten."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "Unesite apsolutnu putanju (počinje s / ili ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "Ova putanja je datoteka, a ne mapa."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "Vrijednost nije prihvaćena, zadržava se stara."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "Vrijednost nije bilo moguće spremiti."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "Mapa nije prihvaćena, zadržava se stara."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "Mapu nije bilo moguće spremiti."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "Nema slika za prikaz"

#: slideshow_lock/preview_app.py
msgid ""
"Show the slideshow preview. Any input ends it. It never locks the session."
msgstr ""
"Prikaži pretpregled prezentacije slika. Svaki unos ga završava. Nikada ne "
"zaključava sesiju."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "mapa sa slikama (samo za ovo pokretanje)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "sekundi po slici (samo za ovo pokretanje)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "redoslijed slika"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "prilagodi ili ispuni monitor"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "polako pomiči slike u portretnom usmjerenju (način ispunjavanja)"

#: slideshow_lock/preview_app.py
msgid "how a picture changes into the next, or none (this run only)"
msgstr ""
"kako se jedna slika mijenja u sljedeću, ili nema (samo za ovo pokretanje)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "Interval mora biti između %d i %d sekundi."

#: slideshow_lock/preview_app.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr ""
"Shema postavki nije instalirana. Kompajlirajte je i usmjerite GSettings na "
"nju:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "Pretpregled aplikacije Slideshow Lock"

#: slideshow_lock/service.py
msgid ""
"Start the slideshow when the session is idle, lock it on the first input "
"after the grace period, and lock before the machine suspends."
msgstr ""
"Pokreni prezentaciju slika kad je sesija neaktivna, zaključaj je pri prvom "
"unosu nakon odgode i zaključaj prije nego što se računalo uspava."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "sekundi neaktivnosti prije prezentacije slika"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "bez zaključavanja za unos unutar ovoliko sekundi"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "Vrijeme neaktivnosti mora biti između 1 i 86400 sekundi."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "Odgoda mora biti između 0 i 86400 sekundi."

#: slideshow_lock/service.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr ""
"Shema postavki nije instalirana. Kompajlirajte je i usmjerite GSettings na "
"nju:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.trensoft.slideshowlock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "Postavite prezentaciju slika pri neaktivnosti i zaključavanje sesije"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr ""
"Čuvar zaslona s prezentacijom slika pri neaktivnosti koji zaključava pri "
"unosu"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"Slideshow Lock starts a fullscreen picture slideshow on every screen when "
"the session has been idle for a set time."
msgstr ""
"Slideshow Lock pokreće prezentaciju slika preko cijelog zaslona na svakom "
"zaslonu kad je sesija neaktivna zadano vrijeme."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The first key press, click or mouse movement ends the slideshow. If the "
"slideshow has been showing for at least the grace period, the session is "
"locked as well."
msgstr ""
"Prvi pritisak tipke, klik ili pomak miša završava prezentaciju slika. Ako se "
"prezentacija slika prikazivala barem toliko koliko traje odgoda, sesija se "
"također zaključava."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The pictures come from a folder you choose. A settings window sets the "
"folder, the idle time, the grace period, how long each picture shows, the "
"order and the scaling."
msgstr ""
"Slike dolaze iz mape koju odaberete. Prozor postavki određuje mapu, vrijeme "
"neaktivnosti, odgodu, koliko dugo se prikazuje svaka slika, redoslijed i "
"skaliranje."

#: slideshow_lock/__init__.py
#: data/io.github.trensoft.slideshowlock.desktop.in
#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "Насумично"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "По имену датотеке"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "Попуни екран (исеца слику)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "Прилагоди (приказује целу слику)"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "Подешавања за Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "Прегледај…"

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "Слике"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "Фасцикла са сликама"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "Редослед слика"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "Скалирање"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "Померај високе слике"

#: slideshow_lock/preferences.py
msgid "Portrait pictures on a landscape screen move slowly from top to bottom (only with Fill). Off by default: it uses more battery."
msgstr "Портретне слике на широком екрану споро се померају од врха ка дну (само уз „Попуни“). Подразумевано је искључено: троши више батерије."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "Покретање приказа слајдова"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "Време мировања"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "Колико дуго без уноса пре почетка приказа слајдова."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "секунди"

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "Време приказа"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "Прикажи сваку слику током"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "Период одлагања закључавања"

#: slideshow_lock/preferences.py
msgid "Input sooner than this after the slideshow starts does not lock the session (strictly sooner; 0 means every input locks)."
msgstr "Унос раније од овог времена након почетка приказа слајдова не закључава сесију (строго раније; 0 значи да сваки унос закључава)."

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "Преглед"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 с"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 мин"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 ч"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 ч"

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "Изаберите фасциклу са сликама"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "Изабери"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "Откажи"

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "Преглед није могао да се покрене, погледајте дневник."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "Нема монитора на коме би се приказао преглед."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr "Преглед је покренут: притисните било који тастер или померите миша да га прекинете."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "Измените подешавања приказа слајдова."

#: slideshow_lock/preferences.py slideshow_lock/preview_app.py
#: slideshow_lock/service.py
msgid "log every step"
msgstr "бележи сваки корак"

#: slideshow_lock/preferences.py
msgid "The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr "Шема подешавања није инсталирана. Компајлирајте је и усмерите GSettings на њу:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "Сачувано."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "најдуже"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d с"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d мин"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d ч"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "У употреби: %s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "У употреби: %s (фасцикла још не постоји, ништа неће бити приказано)"

#: slideshow_lock/preferences_model.py
msgid "Not a step of the slider: it shows the nearest one. The saved value stays until you move the slider."
msgstr "Није корак клизача: приказује се најближи. Сачувана вредност остаје док не померите клизач."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "Унесите цео број секунди."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "Вредност мора бити између %(low)d и %(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "Унесите цео број за положај клизача."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "Овај положај није на клизачу."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "Овај избор није доступан."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "Мора бити укључено или искључено."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "Унесите путању до фасцикле."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "Путања садржи знак који није дозвољен."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "Унесите апсолутну путању (почиње са / или ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "Ова путања је датотека, а не фасцикла."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "Вредност није прихваћена, задржава се стара."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "Вредност није могла да се сачува."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "Фасцикла није прихваћена, задржава се стара."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "Фасцикла није могла да се сачува."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "Нема слика за приказ"

#: slideshow_lock/preview_app.py
msgid "Show the slideshow preview. Any input ends it. It never locks the session."
msgstr "Прикажи преглед приказа слајдова. Сваки унос га завршава. Никада не закључава сесију."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "фасцикла са сликама (само за ово покретање)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "секунди по слици (само за ово покретање)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "редослед слика"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "прилагоди или попуни монитор"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "споро помери портретне слике (режим попуњавања)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "Интервал мора бити између %d и %d секунди."

#: slideshow_lock/preview_app.py
msgid "The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr "Шема подешавања није инсталирана. Компајлирајте је и усмерите GSettings на њу:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "Преглед за Slideshow Lock"

#: slideshow_lock/service.py
msgid "Start the slideshow when the session is idle, lock it on the first input after the grace period, and lock before the machine suspends."
msgstr "Покрени приказ слајдова када је сесија у мировању, закључај је при првом уносу након периода одлагања и закључај је пре него што се рачунар успава."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "секунди мировања пре приказа слајдова"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "без закључавања за унос у оквиру ових секунди"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "Време мировања мора бити између 1 и 86400 секунди."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "Период одлагања мора бити између 0 и 86400 секунди."

#: slideshow_lock/service.py
msgid "The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr "Шема подешавања није инсталирана. Компајлирајте је и усмерите GSettings на њу:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.trensoft.slideshowlock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "Подесите приказ слајдова у мировању и закључавање сесије"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr "Чувар екрана са приказом слајдова који закључава при уносу"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Slideshow Lock starts a fullscreen picture slideshow on every screen when the session has been idle for a set time."
msgstr "Slideshow Lock покреће приказ слајдова преко целог екрана на сваком монитору када је сесија одређено време у мировању."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "The first key press, click or mouse movement ends the slideshow. If the slideshow has been showing for at least the grace period, the session is locked as well."
msgstr "Први притисак тастера, клик или померање миша завршава приказ слајдова. Ако је приказ трајао најмање колико и период одлагања, сесија се такође закључава."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "The pictures come from a folder you choose. A settings window sets the folder, the idle time, the grace period, how long each picture shows, the order and the scaling."
msgstr "Слике долазе из фасцикле коју изаберете. Прозор са подешавањима одређује фасциклу, време мировања, период одлагања, колико дуго се приказује свака слика, редослед и скалирање."

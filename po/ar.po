#: slideshow_lock/__init__.py
#: data/io.github.trensoft.slideshowlock.desktop.in
#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/control.py
msgid "Start the slideshow service and open the settings window."
msgstr "بدء خدمة عرض الشرائح وفتح نافذة الإعدادات."

#: slideshow_lock/control.py
msgid "at login: start the service, open the window only the first time"
msgstr "عند تسجيل الدخول: بدء الخدمة، وفتح النافذة في المرة الأولى فقط"

#: slideshow_lock/control.py slideshow_lock/preferences.py
#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "log every step"
msgstr "تسجيل كل خطوة"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "عشوائي"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "حسب اسم الملف"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "ملء الشاشة (تُقصّ الصورة)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "ملاءمة (تُعرض الصورة كاملة)"

#: slideshow_lock/preferences.py
msgid "None (change at once)"
msgstr "بلا انتقال (تغيير فوري)"

#: slideshow_lock/preferences.py
msgid "Cross-fade"
msgstr "تلاشٍ متداخل"

#: slideshow_lock/preferences.py
msgid "Fade through black"
msgstr "تلاشٍ عبر الأسود"

#: slideshow_lock/preferences.py
msgid "Slide in"
msgstr "انزلاق للداخل"

#: slideshow_lock/preferences.py
msgid "Push"
msgstr "دفع"

#: slideshow_lock/preferences.py
msgid "Ken Burns"
msgstr "Ken Burns"

#: slideshow_lock/preferences.py
msgid "Zoom"
msgstr "تكبير"

#: slideshow_lock/preferences.py
msgid "Wipe"
msgstr "مسح"

#: slideshow_lock/preferences.py
msgid "Circle reveal"
msgstr "كشف دائري"

#: slideshow_lock/preferences.py
msgid "Blur"
msgstr "تمويه"

#: slideshow_lock/preferences.py
msgid "Rotate"
msgstr "تدوير"

#: slideshow_lock/preferences.py
msgid "Random mix"
msgstr "مزيج عشوائي"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "إعدادات Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "مجلد الصور"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "استعراض…"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "ترتيب الصور"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "التحجيم"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "تمرير الصور الطولية"

#: slideshow_lock/preferences.py
msgid ""
"Portrait pictures on a landscape screen move slowly from top to bottom (only "
"with Fill). Off by default: it uses more battery."
msgstr ""
"تتحرك الصور الطولية على شاشة عرضية ببطء من الأعلى إلى الأسفل (عند ملء الشاشة "
"فقط). معطّل افتراضيًا: يستهلك مزيدًا من البطارية."

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "الصور"

#: slideshow_lock/preferences.py
msgid "Between pictures"
msgstr "بين الصور"

#: slideshow_lock/preferences.py
msgid ""
"How a picture changes into the next. \"Random mix\" picks one of eight at "
"each change (not Blur and Ken Burns). Without desktop animations the "
"pictures change at once."
msgstr ""
"كيف تتحول صورة إلى التالية. يختار \"مزيج عشوائي\" واحدًا من ثمانية عند كل "
"تغيير (ليس التمويه ولا Ken Burns). بدون حركات سطح المكتب تتغير الصور فورًا."

#: slideshow_lock/preferences.py
msgid "Transition length"
msgstr "مدة الانتقال"

#: slideshow_lock/preferences.py
msgid ""
"How long one change takes, the same for every transition. It is never longer "
"than half of the time a picture is shown."
msgstr ""
"المدة التي يستغرقها تغيير واحد، وهي نفسها لكل انتقال. لا تزيد أبدًا على نصف "
"مدة عرض الصورة."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "ثوانٍ"

#: slideshow_lock/preferences.py
msgid "Transitions"
msgstr "الانتقالات"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "مدة الخمول"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "المدة بلا إدخال قبل أن يبدأ عرض الشرائح."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "بدء عرض الشرائح"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "عرض كل صورة لمدة"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "فترة السماح للقفل"

#: slideshow_lock/preferences.py
msgid ""
"Input sooner than this after the slideshow starts does not lock the session "
"(strictly sooner; 0 means every input locks)."
msgstr ""
"أي إدخال يحدث قبل انقضاء هذه المدة منذ بدء عرض الشرائح لا يقفل الجلسة (قبلها "
"تمامًا؛ القيمة 0 تعني أن كل إدخال يقفل الجلسة)."

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "التوقيت"

#: slideshow_lock/preferences.py
msgid "Save"
msgstr "حفظ"

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "معاينة"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 ث"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 د"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 س"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 س"

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "اختيار مجلد الصور"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "اختيار"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "إلغاء"

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "تعذّر بدء المعاينة، راجع السجل."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "لا توجد شاشة لعرض المعاينة عليها."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr "المعاينة قيد التشغيل: اضغط أي مفتاح أو حرّك الفأرة لإنهائها."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "تغيير إعدادات عرض الشرائح."

#: slideshow_lock/preferences.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr ""
"مخطط الإعدادات غير مثبّت. قم بتصريفه ووجّه GSettings إليه:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "تم الحفظ."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "الأطول"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d ث"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d د"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d س"

# RTL: the path is wrapped in U+2066 (LRI) ... U+2069 (PDI) so that the leading '/' of an
# absolute path and any right-to-left folder name do not reorder the sentence around it.
#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "قيد الاستخدام: ⁦%s⁩"

# RTL: the path is wrapped in U+2066 (LRI) ... U+2069 (PDI) so that the leading '/' of an
# absolute path and any right-to-left folder name do not reorder the sentence around it.
#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "قيد الاستخدام: ⁦%s⁩ (المجلد غير موجود بعد، ولن يُعرض شيء)"

#: slideshow_lock/preferences_model.py
msgid ""
"Not a step of the slider: it shows the nearest one. The saved value stays "
"until you move the slider."
msgstr ""
"ليست إحدى خطوات شريط التمرير: تُعرض أقرب خطوة. تبقى القيمة المحفوظة كما هي "
"إلى أن تحرّك الشريط."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "أدخل عددًا صحيحًا من الثواني."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "يجب أن تكون القيمة بين %(low)d و%(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "أدخل عددًا صحيحًا لموضع شريط التمرير."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "هذا الموضع ليس على شريط التمرير."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "هذا الخيار غير متاح."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "يجب أن تكون القيمة تشغيلًا أو إيقافًا."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "أدخل مسار مجلد."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "يحتوي المسار على حرف غير مسموح به."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "أدخل مسارًا مطلقًا (يبدأ بـ / أو ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "هذا المسار ملف وليس مجلدًا."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "لم تُقبل القيمة، وبقيت القيمة القديمة."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "تعذّر حفظ القيمة."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "لم يُقبل المجلد، وبقي المجلد القديم."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "تعذّر حفظ المجلد."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "لا توجد صور للعرض"

#: slideshow_lock/preview_app.py
msgid ""
"Show the slideshow preview. Any input ends it. It never locks the session."
msgstr "عرض معاينة عرض الشرائح. أي إدخال ينهيها. لا تقفل الجلسة أبدًا."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "مجلد الصور (لهذا التشغيل فقط)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "ثوانٍ لكل صورة (لهذا التشغيل فقط)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "ترتيب الصور"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "ملاءمة الشاشة أو ملؤها"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "تمرير الصور الطولية ببطء (وضع الملء)"

#: slideshow_lock/preview_app.py
msgid "how a picture changes into the next, or none (this run only)"
msgstr "كيف تتحول صورة إلى التالية، أو بلا انتقال (لهذا التشغيل فقط)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "يجب أن تكون المدة بين %d و%d ثانية."

#: slideshow_lock/preview_app.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr ""
"مخطط الإعدادات غير مثبّت. قم بتصريفه ووجّه GSettings إليه:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "معاينة Slideshow Lock"

#: slideshow_lock/service.py
msgid ""
"Start the slideshow when the session is idle, lock it on the first input "
"after the grace period, and lock before the machine suspends."
msgstr ""
"بدء عرض الشرائح عندما تكون الجلسة خاملة، وقفل الجلسة عند أول إدخال بعد فترة "
"السماح، وقفلها قبل أن يدخل الجهاز في وضع السكون."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "ثوانٍ من الخمول قبل عرض الشرائح"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "عدم القفل عند الإدخال خلال هذا العدد من الثواني"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "يجب أن تكون مدة الخمول بين 1 و86400 ثانية."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "يجب أن تكون فترة السماح بين 0 و86400 ثانية."

#: slideshow_lock/service.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr ""
"مخطط الإعدادات غير مثبّت. قم بتصريفه ووجّه GSettings إليه:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.trensoft.slideshowlock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "إعداد عرض الشرائح عند الخمول وقفل الجلسة"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr "شاشة توقف بعرض الشرائح عند الخمول تقفل الجلسة عند أي إدخال"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"Slideshow Lock starts a fullscreen picture slideshow on every screen when "
"the session has been idle for a set time."
msgstr ""
"يبدأ Slideshow Lock عرض الشرائح بالصور بملء الشاشة على كل شاشة عندما تبقى "
"الجلسة خاملة لمدة محددة."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The first key press, click or mouse movement ends the slideshow. If the "
"slideshow has been showing for at least the grace period, the session is "
"locked as well."
msgstr ""
"أول ضغطة مفتاح أو نقرة أو حركة للفأرة تنهي عرض الشرائح. وإذا استمر العرض مدة "
"لا تقل عن فترة السماح، تُقفل الجلسة أيضًا."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The pictures come from a folder you choose. A settings window sets the "
"folder, the idle time, the grace period, how long each picture shows, the "
"order and the scaling."
msgstr ""
"تأتي الصور من مجلد تختاره. تضبط نافذة الإعدادات المجلد ومدة الخمول وفترة "
"السماح ومدة عرض كل صورة والترتيب والتحجيم."

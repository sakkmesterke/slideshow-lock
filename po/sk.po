#: slideshow_lock/__init__.py
#: data/io.github.sakkmesterke.SlideshowLock.desktop.in
#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/control.py
msgid "Start the slideshow service and open the settings window."
msgstr "Spustiť službu prezentácie a otvoriť okno nastavení."

#: slideshow_lock/control.py
msgid "at login: start the service, open the window only the first time"
msgstr "pri prihlásení: spustiť službu, okno otvoriť iba prvýkrát"

#: slideshow_lock/control.py slideshow_lock/preferences.py
#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "log every step"
msgstr "zaznamenávať každý krok"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "Náhodne"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "Podľa názvu súboru"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "Vyplniť obrazovku (orezáva obrázok)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "Prispôsobiť (zobrazí celý obrázok)"

#: slideshow_lock/preferences.py
msgid "None (change at once)"
msgstr "Žiadny (zmeniť hneď)"

#: slideshow_lock/preferences.py
msgid "Cross-fade"
msgstr "Prelínanie"

#: slideshow_lock/preferences.py
msgid "Fade through black"
msgstr "Stmievanie cez čiernu"

#: slideshow_lock/preferences.py
msgid "Slide in"
msgstr "Vsunutie"

#: slideshow_lock/preferences.py
msgid "Push"
msgstr "Vytlačenie"

#: slideshow_lock/preferences.py
msgid "Ken Burns"
msgstr "Ken Burns"

#: slideshow_lock/preferences.py
msgid "Zoom"
msgstr "Priblíženie"

#: slideshow_lock/preferences.py
msgid "Wipe"
msgstr "Stieranie"

#: slideshow_lock/preferences.py
msgid "Circle reveal"
msgstr "Kruhové odhalenie"

#: slideshow_lock/preferences.py
msgid "Blur"
msgstr "Rozmazanie"

#: slideshow_lock/preferences.py
msgid "Rotate"
msgstr "Otočenie"

#: slideshow_lock/preferences.py
msgid "Random mix"
msgstr "Náhodný mix"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "Nastavenia Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "Priečinok s obrázkami"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "Prehľadávať…"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "Poradie obrázkov"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "Škálovanie"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "Posúvať vysoké obrázky"

#: slideshow_lock/preferences.py
msgid ""
"Portrait pictures on a landscape screen move slowly from top to bottom (only "
"with Fill). Off by default: it uses more battery."
msgstr ""
"Obrázky na výšku na obrazovke na šírku sa pomaly posúvajú zhora nadol (iba s "
"možnosťou Vyplniť). Predvolene vypnuté: spotrebúva viac batérie."

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "Obrázky"

#: slideshow_lock/preferences.py
msgid "Between pictures"
msgstr "Medzi obrázkami"

#: slideshow_lock/preferences.py
msgid ""
"How a picture changes into the next. \"Random mix\" picks one of eight at "
"each change (not Blur and Ken Burns). Without desktop animations the "
"pictures change at once."
msgstr ""
"Ako sa jeden obrázok mení na ďalší. \"Náhodný mix\" pri každej zmene vyberie "
"jeden z ôsmich (okrem Rozmazania a Ken Burns). Bez animácií pracovného "
"prostredia sa obrázky menia hneď."

#: slideshow_lock/preferences.py
msgid "Transition length"
msgstr "Dĺžka prechodu"

#: slideshow_lock/preferences.py
msgid ""
"How long one change takes, the same for every transition. It is never longer "
"than half of the time a picture is shown."
msgstr ""
"Ako dlho trvá jedna zmena, rovnako pri každom prechode. Nikdy nie je dlhšia "
"ako polovica času, počas ktorého sa zobrazuje obrázok."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "sekundy"

#: slideshow_lock/preferences.py
msgid "Hardware acceleration"
msgstr "Hardvérová akcelerácia"

#: slideshow_lock/preferences.py
msgid "Transitions"
msgstr "Prechody"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "Čas nečinnosti"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "Ako dlho bez vstupu, kým sa prezentácia spustí."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "Spustiť prezentáciu"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "Zobrazovať každý obrázok počas"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "Ochranná lehota uzamknutia"

#: slideshow_lock/preferences.py
msgid ""
"Input sooner than this after the slideshow starts does not lock the session "
"(strictly sooner; 0 means every input locks)."
msgstr ""
"Vstup skôr, než uplynie táto doba od spustenia prezentácie, reláciu "
"neuzamkne (striktne skôr; 0 znamená, že každý vstup uzamkne)."

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "Časovanie"

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "Náhľad"

#: slideshow_lock/preferences.py
msgid "Save"
msgstr "Uložiť"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 s"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 min"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 h"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 h"

#: slideshow_lock/preferences.py
msgid ""
"Slow movement and soft edges in the transitions. Turn it off for the plain "
"animation."
msgstr ""
"Pomalý pohyb a jemné okraje v prechodoch. Vypnite pre jednoduchú animáciu."

#: slideshow_lock/preferences.py
msgid ""
"Not available: this computer does not draw with a graphics card, so the "
"plain animation is used."
msgstr ""
"Nedostupné: tento počítač nekreslí pomocou grafickej karty, preto sa používa "
"jednoduchá animácia."

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "Vyberte priečinok s obrázkami"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "Vybrať"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "Zrušiť"

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "Náhľad sa nepodarilo spustiť, pozrite si záznam."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "Nie je k dispozícii žiadny monitor na zobrazenie náhľadu."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr ""
"Náhľad beží: stlačením ľubovoľného klávesu alebo pohnutím myši ho ukončíte."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "Zmeniť nastavenia prezentácie."

#: slideshow_lock/preferences.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr ""
"Schéma nastavení nie je nainštalovaná. Skompilujte ju a nasmerujte na ňu "
"GSettings:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "Uložené."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "najdlhší"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d min"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d h"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "Používa sa: %s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "Používa sa: %s (priečinok zatiaľ neexistuje, nič sa nezobrazí)"

#: slideshow_lock/preferences_model.py
msgid ""
"Not a step of the slider: it shows the nearest one. The saved value stays "
"until you move the slider."
msgstr ""
"Nie je to krok posuvníka: zobrazí sa najbližší. Uložená hodnota zostane, kým "
"neposuniete posuvník."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "Zadajte celé číslo sekúnd."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "Hodnota musí byť medzi %(low)d a %(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "Zadajte celé číslo pre polohu posuvníka."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "Táto poloha nie je na posuvníku."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "Táto voľba nie je dostupná."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "Toto musí byť zapnuté alebo vypnuté."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "Zadajte cestu k priečinku."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "Cesta obsahuje nepovolený znak."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "Zadajte absolútnu cestu (začína sa znakom / alebo ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "Táto cesta je súbor, nie priečinok."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "Hodnota nebola prijatá, ponecháva sa pôvodná."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "Hodnotu sa nepodarilo uložiť."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "Priečinok nebol prijatý, ponecháva sa pôvodný."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "Priečinok sa nepodarilo uložiť."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "Žiadne obrázky na zobrazenie"

#: slideshow_lock/preview_app.py
msgid ""
"Show the slideshow preview. Any input ends it. It never locks the session."
msgstr ""
"Zobraziť náhľad prezentácie. Ukončí ho akýkoľvek vstup. Reláciu nikdy "
"neuzamkne."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "priečinok s obrázkami (iba toto spustenie)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "sekúnd na obrázok (iba toto spustenie)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "poradie obrázkov"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "prispôsobiť alebo vyplniť monitor"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "pomaly posúvať obrázky na výšku (režim vyplnenia)"

#: slideshow_lock/preview_app.py
msgid "how a picture changes into the next, or none (this run only)"
msgstr ""
"ako sa jeden obrázok mení na ďalší, alebo vôbec (len pri tomto spustení)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "Interval musí byť medzi %d a %d sekundami."

#: slideshow_lock/preview_app.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr ""
"Schéma nastavení nie je nainštalovaná. Skompilujte ju a nasmerujte na ňu "
"GSettings:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "Náhľad Slideshow Lock"

#: slideshow_lock/service.py
msgid ""
"Start the slideshow when the session is idle, lock it on the first input "
"after the grace period, and lock before the machine suspends."
msgstr ""
"Spustiť prezentáciu, keď je relácia nečinná, uzamknúť ju pri prvom vstupe po "
"ochrannej lehote a uzamknúť pred uspaním počítača."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "sekúnd nečinnosti pred prezentáciou"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "žiadne uzamknutie pri vstupe v rámci tohto počtu sekúnd"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "Časový limit nečinnosti musí byť medzi 1 a 86400 sekundami."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "Ochranná lehota musí byť medzi 0 a 86400 sekundami."

#: slideshow_lock/service.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr ""
"Schéma nastavení nie je nainštalovaná. Skompilujte ju a nasmerujte na ňu "
"GSettings:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.sakkmesterke.SlideshowLock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "Nastaviť prezentáciu pri nečinnosti a uzamknutie relácie"

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr ""
"Šetrič obrazovky s prezentáciou pri nečinnosti, ktorý uzamkne pri vstupe"

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid ""
"Slideshow Lock starts a fullscreen picture slideshow on every screen when "
"the session has been idle for a set time."
msgstr ""
"Slideshow Lock spustí prezentáciu obrázkov na celej obrazovke na každej "
"obrazovke, keď bola relácia nečinná nastavený čas."

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid ""
"The first key press, click or mouse movement ends the slideshow. If the "
"slideshow has been showing for at least the grace period, the session is "
"locked as well."
msgstr ""
"Prvé stlačenie klávesu, kliknutie alebo pohyb myši ukončí prezentáciu. Ak sa "
"prezentácia zobrazovala aspoň počas ochrannej lehoty, relácia sa tiež "
"uzamkne."

#: data/io.github.sakkmesterke.SlideshowLock.metainfo.xml.in
msgid ""
"The pictures come from a folder you choose. A settings window sets the "
"folder, the idle time, the grace period, how long each picture shows, the "
"order and the scaling."
msgstr ""
"Obrázky pochádzajú z priečinka, ktorý si vyberiete. Okno nastavení určuje "
"priečinok, čas nečinnosti, ochrannú lehotu, ako dlho sa zobrazuje každý "
"obrázok, poradie a škálovanie."

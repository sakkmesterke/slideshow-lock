#: slideshow_lock/__init__.py
#: data/io.github.trensoft.slideshowlock.desktop.in
#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/control.py
msgid "Start the slideshow service and open the settings window."
msgstr "Start tjenesten for lysbildefremvisning og åpne innstillingsvinduet."

#: slideshow_lock/control.py
msgid "at login: start the service, open the window only the first time"
msgstr "ved pålogging: start tjenesten, åpne vinduet bare første gang"

#: slideshow_lock/control.py slideshow_lock/preferences.py
#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "log every step"
msgstr "logg hvert steg"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "Tilfeldig"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "Etter filnavn"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "Fyll skjermen (beskjærer bildet)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "Tilpass (viser hele bildet)"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "Innstillinger for Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "Bla gjennom …"

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "Bilder"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "Bildemappe"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "Rekkefølge på bildene"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "Skalering"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "Rull høye bilder"

#: slideshow_lock/preferences.py
msgid ""
"Portrait pictures on a landscape screen move slowly from top to bottom (only "
"with Fill). Off by default: it uses more battery."
msgstr ""
"Stående bilder på en liggende skjerm beveger seg sakte fra topp til bunn "
"(bare med Fyll). Av som standard: det bruker mer batteri."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "Start lysbildefremvisningen"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "Inaktivitetstid"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "Hvor lenge uten inndata før lysbildefremvisningen starter."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "sekunder"

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "Tidsstyring"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "Vis hvert bilde i"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "Frist før låsing"

#: slideshow_lock/preferences.py
msgid ""
"Input sooner than this after the slideshow starts does not lock the session "
"(strictly sooner; 0 means every input locks)."
msgstr ""
"Inndata tidligere enn dette etter at lysbildefremvisningen har startet låser "
"ikke økten (strengt tidligere; 0 betyr at all inndata låser)."

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "Forhåndsvisning"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 s"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 min"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 t"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 t"

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "Velg bildemappen"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "Velg"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "Avbryt"

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "Forhåndsvisningen kunne ikke startes, se loggen."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "Det finnes ingen skjerm å vise forhåndsvisningen på."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr ""
"Forhåndsvisning pågår: trykk på en tast eller flytt musen for å avslutte den."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "Endre innstillingene for lysbildefremvisningen."

#: slideshow_lock/preferences.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr ""
"Innstillingsskjemaet er ikke installert. Kompiler det og pek GSettings til "
"det:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "Lagret."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "den lengste"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d min"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d t"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "I bruk: %s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "I bruk: %s (mappen finnes ikke ennå, ingenting vil bli vist)"

#: slideshow_lock/preferences_model.py
msgid ""
"Not a step of the slider: it shows the nearest one. The saved value stays "
"until you move the slider."
msgstr ""
"Ikke et trinn på glidebryteren: den nærmeste vises. Den lagrede verdien "
"beholdes til du flytter glidebryteren."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "Skriv inn et helt antall sekunder."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "Verdien må være mellom %(low)d og %(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "Skriv inn et helt tall for posisjonen til glidebryteren."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "Denne posisjonen finnes ikke på glidebryteren."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "Dette valget er ikke tilgjengelig."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "Dette må være på eller av."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "Skriv inn en mappesti."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "Stien inneholder et tegn som ikke er tillatt."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "Skriv inn en absolutt sti (den begynner med / eller ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "Denne stien er en fil, ikke en mappe."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "Verdien ble ikke godtatt, den gamle beholdes."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "Verdien kunne ikke lagres."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "Mappen ble ikke godtatt, den gamle beholdes."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "Mappen kunne ikke lagres."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "Ingen bilder å vise"

#: slideshow_lock/preview_app.py
msgid ""
"Show the slideshow preview. Any input ends it. It never locks the session."
msgstr ""
"Vis forhåndsvisningen av lysbildefremvisningen. All inndata avslutter den. "
"Den låser aldri økten."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "bildemappe (bare denne kjøringen)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "sekunder per bilde (bare denne kjøringen)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "rekkefølge på bildene"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "tilpass eller fyll skjermen"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "rull stående bilder sakte (fyllmodus)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "Intervallet må være mellom %d og %d sekunder."

#: slideshow_lock/preview_app.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr ""
"Innstillingsskjemaet er ikke installert. Kompiler det og pek GSettings til "
"det:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "Forhåndsvisning av Slideshow Lock"

#: slideshow_lock/service.py
msgid ""
"Start the slideshow when the session is idle, lock it on the first input "
"after the grace period, and lock before the machine suspends."
msgstr ""
"Start lysbildefremvisningen når økten er inaktiv, lås den ved første inndata "
"etter fristen, og lås før maskinen går i hvilemodus."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "sekunder inaktivitet før lysbildefremvisningen"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "ingen låsing ved inndata innen så mange sekunder"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "Tidsavbruddet for inaktivitet må være mellom 1 og 86400 sekunder."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "Fristen må være mellom 0 og 86400 sekunder."

#: slideshow_lock/service.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr ""
"Innstillingsskjemaet er ikke installert. Kompiler det og pek GSettings til "
"det:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.trensoft.slideshowlock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "Sett opp lysbildefremvisningen ved inaktivitet og øktlåsen"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr ""
"Skjermsparer med lysbildefremvisning ved inaktivitet, som låser ved inndata"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"Slideshow Lock starts a fullscreen picture slideshow on every screen when "
"the session has been idle for a set time."
msgstr ""
"Slideshow Lock starter en lysbildefremvisning med bilder i fullskjerm på "
"hver skjerm når økten har vært inaktiv en innstilt tid."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The first key press, click or mouse movement ends the slideshow. If the "
"slideshow has been showing for at least the grace period, the session is "
"locked as well."
msgstr ""
"Første tastetrykk, klikk eller musebevegelse avslutter "
"lysbildefremvisningen. Hvis lysbildefremvisningen har vært vist i minst "
"fristen, blir økten også låst."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The pictures come from a folder you choose. A settings window sets the "
"folder, the idle time, the grace period, how long each picture shows, the "
"order and the scaling."
msgstr ""
"Bildene kommer fra en mappe du velger. Et innstillingsvindu angir mappen, "
"inaktivitetstiden, fristen, hvor lenge hvert bilde vises, rekkefølgen og "
"skaleringen."

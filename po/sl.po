#: slideshow_lock/__init__.py
#: data/io.github.trensoft.slideshowlock.desktop.in
#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Slideshow Lock"
msgstr "Slideshow Lock"

#: slideshow_lock/control.py
msgid "Start the slideshow service and open the settings window."
msgstr "Zaženi storitev diaprojekcije in odpri okno z nastavitvami."

#: slideshow_lock/control.py
msgid "at login: start the service, open the window only the first time"
msgstr "ob prijavi: zaženi storitev, okno odpri samo prvič"

#: slideshow_lock/control.py slideshow_lock/preferences.py
#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "log every step"
msgstr "beleži vsak korak"

#: slideshow_lock/preferences.py
msgid "Random"
msgstr "Naključno"

#: slideshow_lock/preferences.py
msgid "By file name"
msgstr "Po imenu datoteke"

#: slideshow_lock/preferences.py
msgid "Fill the screen (crops the picture)"
msgstr "Zapolni zaslon (obreže sliko)"

#: slideshow_lock/preferences.py
msgid "Fit (shows the whole picture)"
msgstr "Prilagodi (prikaže celotno sliko)"

#: slideshow_lock/preferences.py
msgid "None (change at once)"
msgstr "Brez (zamenjaj takoj)"

#: slideshow_lock/preferences.py
msgid "Cross-fade"
msgstr "Križno prelivanje"

#: slideshow_lock/preferences.py
msgid "Fade through black"
msgstr "Pojemanje skozi črno"

#: slideshow_lock/preferences.py
msgid "Slide in"
msgstr "Drsenje noter"

#: slideshow_lock/preferences.py
msgid "Push"
msgstr "Potisk"

#: slideshow_lock/preferences.py
msgid "Ken Burns"
msgstr "Ken Burns"

#: slideshow_lock/preferences.py
msgid "Zoom"
msgstr "Povečava"

#: slideshow_lock/preferences.py
msgid "Wipe"
msgstr "Brisanje"

#: slideshow_lock/preferences.py
msgid "Circle reveal"
msgstr "Krožno razkritje"

#: slideshow_lock/preferences.py
msgid "Blur"
msgstr "Zameglitev"

#: slideshow_lock/preferences.py
msgid "Rotate"
msgstr "Vrtenje"

#: slideshow_lock/preferences.py
msgid "Random mix"
msgstr "Naključna mešanica"

#: slideshow_lock/preferences.py
msgid "Slideshow Lock settings"
msgstr "Nastavitve za Slideshow Lock"

#: slideshow_lock/preferences.py
msgid "Picture folder"
msgstr "Mapa s slikami"

#: slideshow_lock/preferences.py
msgid "Browse..."
msgstr "Prebrskaj …"

#: slideshow_lock/preferences.py
msgid "Picture order"
msgstr "Vrstni red slik"

#: slideshow_lock/preferences.py
msgid "Scaling"
msgstr "Skaliranje"

#: slideshow_lock/preferences.py
msgid "Scroll tall pictures"
msgstr "Pomikaj visoke slike"

#: slideshow_lock/preferences.py
msgid ""
"Portrait pictures on a landscape screen move slowly from top to bottom (only "
"with Fill). Off by default: it uses more battery."
msgstr ""
"Pokončne slike na ležečem zaslonu se počasi premikajo od zgoraj navzdol "
"(samo z možnostjo Zapolni). Privzeto izklopljeno: porablja več baterije."

#: slideshow_lock/preferences.py
msgid "Pictures"
msgstr "Slike"

#: slideshow_lock/preferences.py
msgid "Between pictures"
msgstr "Med slikami"

#: slideshow_lock/preferences.py
msgid ""
"How a picture changes into the next. \"Random mix\" picks one of eight at "
"each change (not Blur and Ken Burns). Without desktop animations the "
"pictures change at once."
msgstr ""
"Kako se ena slika spremeni v naslednjo. \"Naključna mešanica\" ob vsaki "
"spremembi izbere eno od osmih (brez Zameglitve in Ken Burns). Brez animacij "
"namizja se slike zamenjajo takoj."

#: slideshow_lock/preferences.py
msgid "Transition length"
msgstr "Trajanje prehoda"

#: slideshow_lock/preferences.py
msgid ""
"How long one change takes, the same for every transition. It is never longer "
"than half of the time a picture is shown."
msgstr ""
"Kako dolgo traja ena sprememba, enako za vsak prehod. Nikoli ni daljša od "
"polovice časa, ko je prikazana slika."

#: slideshow_lock/preferences.py
msgid "seconds"
msgstr "sekund"

#: slideshow_lock/preferences.py
msgid "Hardware acceleration"
msgstr "Strojno pospeševanje"

#: slideshow_lock/preferences.py
msgid "Transitions"
msgstr "Prehodi"

#: slideshow_lock/preferences.py
msgid "Idle time"
msgstr "Čas nedejavnosti"

#: slideshow_lock/preferences.py
msgid "How long without input before the slideshow starts."
msgstr "Kako dolgo brez vnosa, preden se diaprojekcija zažene."

#: slideshow_lock/preferences.py
msgid "Start the slideshow"
msgstr "Zaženi diaprojekcijo"

#: slideshow_lock/preferences.py
msgid "Show each picture for"
msgstr "Prikaži vsako sliko"

#: slideshow_lock/preferences.py
msgid "Lock grace period"
msgstr "Odlog zaklepa"

#: slideshow_lock/preferences.py
msgid ""
"Input sooner than this after the slideshow starts does not lock the session "
"(strictly sooner; 0 means every input locks)."
msgstr ""
"Vnos, ki se zgodi prej kot ta čas po začetku diaprojekcije, ne zaklene seje "
"(strogo prej; 0 pomeni, da vsak vnos zaklene)."

#: slideshow_lock/preferences.py
msgid "Timing"
msgstr "Časi"

#: slideshow_lock/preferences.py
msgid "Preview"
msgstr "Predogled"

#: slideshow_lock/preferences.py
msgid "Save"
msgstr "Shrani"

#: slideshow_lock/preferences.py
msgid "10 s"
msgstr "10 s"

#: slideshow_lock/preferences.py
msgid "1 min"
msgstr "1 min"

#: slideshow_lock/preferences.py
msgid "1 h"
msgstr "1 h"

#: slideshow_lock/preferences.py
msgid "24 h"
msgstr "24 h"

#: slideshow_lock/preferences.py
msgid ""
"Slow movement and soft edges in the transitions. Turn it off for the plain "
"animation."
msgstr ""
"Počasno gibanje in mehki robovi v prehodih. Izklopite za preprosto animacijo."

#: slideshow_lock/preferences.py
msgid ""
"Not available: this computer does not draw with a graphics card, so the "
"plain animation is used."
msgstr ""
"Ni na voljo: ta računalnik ne riše z grafično kartico, zato se uporablja "
"preprosta animacija."

#: slideshow_lock/preferences.py
msgid "Choose the picture folder"
msgstr "Izberite mapo s slikami"

#: slideshow_lock/preferences.py
msgid "Select"
msgstr "Izberi"

#: slideshow_lock/preferences.py
msgid "Cancel"
msgstr "Prekliči"

#: slideshow_lock/preferences.py
msgid "The preview could not be started, see the log."
msgstr "Predogleda ni bilo mogoče zagnati, glejte dnevnik."

#: slideshow_lock/preferences.py
msgid "There is no monitor to show the preview on."
msgstr "Ni monitorja, na katerem bi lahko prikazali predogled."

#: slideshow_lock/preferences.py
msgid "Preview running: press any key or move the mouse to end it."
msgstr ""
"Predogled teče: pritisnite katero koli tipko ali premaknite miško, da ga "
"končate."

#: slideshow_lock/preferences.py
msgid "Change the slideshow settings."
msgstr "Spremenite nastavitve diaprojekcije."

#: slideshow_lock/preferences.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"
msgstr ""
"Shema nastavitev ni nameščena. Skompilirajte jo in nanjo usmerite "
"GSettings:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preferences"

#: slideshow_lock/preferences_model.py
msgid "Saved."
msgstr "Shranjeno."

#: slideshow_lock/preferences_model.py
msgid "the longest"
msgstr "najdaljši"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d s"
msgstr "%d s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d min"
msgstr "%d min"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "%d h"
msgstr "%d h"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s"
msgstr "V uporabi: %s"

#: slideshow_lock/preferences_model.py
#, python-format
msgid "In use: %s (the folder does not exist yet, nothing will be shown)"
msgstr "V uporabi: %s (mapa še ne obstaja, nič se ne bo prikazalo)"

#: slideshow_lock/preferences_model.py
msgid ""
"Not a step of the slider: it shows the nearest one. The saved value stays "
"until you move the slider."
msgstr ""
"To ni korak drsnika: prikazan je najbližji. Shranjena vrednost ostane, "
"dokler ne premaknete drsnika."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number of seconds."
msgstr "Vnesite celo število sekund."

#: slideshow_lock/preferences_model.py
#, python-format
msgid "The value must be between %(low)d and %(high)d."
msgstr "Vrednost mora biti med %(low)d in %(high)d."

#: slideshow_lock/preferences_model.py
msgid "Enter a whole number for the slider position."
msgstr "Vnesite celo število za položaj drsnika."

#: slideshow_lock/preferences_model.py
msgid "This position is not on the slider."
msgstr "Tega položaja ni na drsniku."

#: slideshow_lock/preferences_model.py
msgid "This choice is not available."
msgstr "Ta izbira ni na voljo."

#: slideshow_lock/preferences_model.py
msgid "This must be on or off."
msgstr "To mora biti vklopljeno ali izklopljeno."

#: slideshow_lock/preferences_model.py
msgid "Enter a folder path."
msgstr "Vnesite pot do mape."

#: slideshow_lock/preferences_model.py
msgid "The path contains a character that is not allowed."
msgstr "Pot vsebuje znak, ki ni dovoljen."

#: slideshow_lock/preferences_model.py
msgid "Enter an absolute path (it starts with / or ~)."
msgstr "Vnesite absolutno pot (začne se z / ali ~)."

#: slideshow_lock/preferences_model.py
msgid "This path is a file, not a folder."
msgstr "Ta pot je datoteka, ne mapa."

#: slideshow_lock/preferences_model.py
msgid "The value was not accepted, the old one is kept."
msgstr "Vrednost ni bila sprejeta, stara ostane."

#: slideshow_lock/preferences_model.py
msgid "The value could not be saved."
msgstr "Vrednosti ni bilo mogoče shraniti."

#: slideshow_lock/preferences_model.py
msgid "The folder was not accepted, the old one is kept."
msgstr "Mapa ni bila sprejeta, stara ostane."

#: slideshow_lock/preferences_model.py
msgid "The folder could not be saved."
msgstr "Mape ni bilo mogoče shraniti."

#: slideshow_lock/preview.py
msgid "No pictures to show"
msgstr "Ni slik za prikaz"

#: slideshow_lock/preview_app.py
msgid ""
"Show the slideshow preview. Any input ends it. It never locks the session."
msgstr ""
"Pokaži predogled diaprojekcije. Konča ga vsak vnos. Seje nikoli ne zaklene."

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture folder (this run only)"
msgstr "mapa s slikami (samo ta zagon)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "seconds per picture (this run only)"
msgstr "sekund na sliko (samo ta zagon)"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "picture order"
msgstr "vrstni red slik"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "fit or fill the monitor"
msgstr "prilagodi ali zapolni monitor"

#: slideshow_lock/preview_app.py slideshow_lock/service.py
msgid "scroll portrait pictures slowly (fill mode)"
msgstr "počasi pomikaj pokončne slike (način zapolni)"

#: slideshow_lock/preview_app.py
msgid "how a picture changes into the next, or none (this run only)"
msgstr ""
"kako se ena slika spremeni v naslednjo ali brez prehoda (samo ta zagon)"

#: slideshow_lock/preview_app.py
#, python-format
msgid "The interval must be between %d and %d seconds."
msgstr "Interval mora biti med %d in %d sekundami."

#: slideshow_lock/preview_app.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"
msgstr ""
"Shema nastavitev ni nameščena. Skompilirajte jo in nanjo usmerite "
"GSettings:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.preview_app"

#: slideshow_lock/preview_window.py
msgid "Slideshow Lock preview"
msgstr "Predogled Slideshow Lock"

#: slideshow_lock/service.py
msgid ""
"Start the slideshow when the session is idle, lock it on the first input "
"after the grace period, and lock before the machine suspends."
msgstr ""
"Zaženi diaprojekcijo, ko je seja nedejavna, ob prvem vnosu po odlogu zaklepa "
"zakleni sejo in zakleni jo pred prehodom računalnika v stanje mirovanja."

#: slideshow_lock/service.py
msgid "idle seconds before the slideshow"
msgstr "sekunde nedejavnosti pred diaprojekcijo"

#: slideshow_lock/service.py
msgid "no lock for input within this many seconds"
msgstr "brez zaklepa za vnos v tem številu sekund"

#: slideshow_lock/service.py
msgid "The idle timeout must be between 1 and 86400 seconds."
msgstr "Časovna omejitev nedejavnosti mora biti med 1 in 86400 sekundami."

#: slideshow_lock/service.py
msgid "The grace period must be between 0 and 86400 seconds."
msgstr "Odlog mora biti med 0 in 86400 sekundami."

#: slideshow_lock/service.py
msgid ""
"The settings schema is not installed. Compile it and point GSettings at it:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"
msgstr ""
"Shema nastavitev ni nameščena. Skompilirajte jo in nanjo usmerite "
"GSettings:\n"
"  glib-compile-schemas data/\n"
"  GSETTINGS_SCHEMA_DIR=data python3 -m slideshow_lock.service"

#: data/io.github.trensoft.slideshowlock.desktop.in
msgid "Set up the idle slideshow and the session lock"
msgstr "Nastavite diaprojekcijo ob nedejavnosti in zaklep seje"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid "Idle slideshow screensaver that locks on input"
msgstr ""
"Ohranjevalnik zaslona z diaprojekcijo ob nedejavnosti, ki zaklene ob vnosu"

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"Slideshow Lock starts a fullscreen picture slideshow on every screen when "
"the session has been idle for a set time."
msgstr ""
"Slideshow Lock zažene celozaslonsko diaprojekcijo slik na vsakem zaslonu, ko "
"je bila seja nedejavna določen čas."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The first key press, click or mouse movement ends the slideshow. If the "
"slideshow has been showing for at least the grace period, the session is "
"locked as well."
msgstr ""
"Prvi pritisk tipke, klik ali premik miške konča diaprojekcijo. Če se je "
"diaprojekcija prikazovala vsaj toliko, kot traja odlog, je seja tudi "
"zaklenjena."

#: data/io.github.trensoft.slideshowlock.metainfo.xml.in
msgid ""
"The pictures come from a folder you choose. A settings window sets the "
"folder, the idle time, the grace period, how long each picture shows, the "
"order and the scaling."
msgstr ""
"Slike prihajajo iz mape, ki jo izberete. Okno z nastavitvami nastavi mapo, "
"čas nedejavnosti, odlog, kako dolgo se prikaže vsaka slika, vrstni red in "
"skaliranje."
